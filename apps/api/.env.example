NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/slotix?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Opcional: chave dos tokens temporários do login social no telemóvel (state/handoff).
# Sem ela é derivada de JWT_ACCESS_SECRET. Use segredos diferentes e com 32+ caracteres
# aleatórios em JWT_ACCESS_SECRET, JWT_REFRESH_SECRET e JWT_OAUTH_SECRET.
JWT_OAUTH_SECRET=

WEB_URL=http://localhost:3001
# Outras origens de browser autorizadas (separadas por vírgula), ex. a versão web da app
# mobile. Em development qualquer origem é aceite.
CORS_ORIGINS=
MOBILE_APP_SCHEME=slotix
# Atrás de um proxy/balanceador: quantos saltos confiar para o IP do cliente (ex.: 1).
# Vazio = não confiar em X-Forwarded-For. Usado pelos limites de pedidos por IP.
TRUST_PROXY=
# Segredo partilhado (32+ caracteres aleatórios, diferente dos JWT) com o servidor do painel
# web, que assina os pedidos que reencaminha com o IP do utilizador. Definir o MESMO valor
# como INTERNAL_PROXY_SECRET nas variáveis de servidor da web (nunca NEXT_PUBLIC_*), e lá
# também TRUSTED_CLIENT_IP_HEADER (ex.: x-real-ip na Vercel). Ver shared/internalProxy.ts.
INTERNAL_PROXY_SECRET=
# Documentação Swagger (/api/v1/docs): desligada em produção, a menos que seja "true".
ENABLE_API_DOCS=
# Fuso dos clientes: o "hoje"/"amanhã" e a hora escritos nos avisos de agendamento.
APP_TIMEZONE=Africa/Luanda

# Login com Google no painel (cliente OAuth do tipo "Aplicação Web" na Google Cloud).
# Em "URIs de redirecionamento autorizados" tem de estar <WEB_URL>/api/auth/google/callback.
# Sem isto, só o botão "Continuar com Google" deixa de funcionar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Login com Google na app: a Google devolve o browser do telemóvel a
# <endereço público da API>/api/v1/auth/google/mobile/callback, que também tem de estar nos
# URIs autorizados (a Google só aceita https ou localhost, nunca um IP da rede local).
# Só é preciso indicar o endereço aqui se a API não o conseguir ler do pedido.
API_PUBLIC_URL=
# "Iniciar sessão com a Apple" (iPhone): o bundle id da app.
APPLE_CLIENT_IDS=com.nevrix.slotix
# "Continuar com Apple" no Android (passa pelo browser): o Services ID criado em
# Apple Developer → Identifiers, com o domínio da API e o Return URL
# <endereço público da API>/api/v1/auth/apple/mobile/callback (tem de ser https).
APPLE_SERVICE_ID=

# Só necessário para a Gallery (upload de imagens). Sem isto configurado, o resto da
# API funciona normalmente e só os endpoints de /gallery falham.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=slotix-gallery

# Geocoding com OpenStreetMap (Nominatim), usado só para o dono marcar o espaço no mapa.
# O servidor público não precisa de chave, mas a política de uso exige que a aplicação se
# identifique: ponha um email de contacto. Limite: 1 pedido por segundo (a API respeita-o).
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AgendaPlus/1.0
NOMINATIM_EMAIL=
# De onde vem a lista das províncias de Angola (OpenStreetMap, via Overpass).
OVERPASS_URL=https://overpass-api.de/api/interpreter
