# URL da API (so servidor: usada pelas rotas /api e pelo lib/ do Next).
# Em desenvolvimento (next dev) vale o .env com o localhost.
# Uma variavel definida no painel do alojamento tem prioridade sobre este ficheiro.
NEXT_API_URL=https://agenda-hrit.onrender.com/api/v1

# Endereco publico do site. Fixa o redirect do login com Google
# (<NEXT_APP_URL>/api/auth/google/callback), que tem de estar autorizado na
# Google Cloud e cuja origem tem de estar em WEB_URL/CORS_ORIGINS da API.
NEXT_APP_URL=https://agenda-nivrix.vercel.app
