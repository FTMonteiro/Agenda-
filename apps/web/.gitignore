# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local credentials and cookie jars
cookies.txt
*.cookies.txt

# editor swap and temporary files
*.swp
*.swo
*.swn
*.tmp
*.temp
*.orig
*~

# local backups
*.bak
*.backup

# local database test editor artifact
.test-db.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma
