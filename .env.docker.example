# Copiar para .env (na raiz do projeto) só se quiser ativar estes extras no Docker.
# Nunca pôr aqui as credenciais da base de dados de produção.

# Login com Google no painel. No cliente OAuth da Google Cloud, os URIs autorizados têm de
# incluir http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upload de imagens da galeria.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=slotix-gallery

# Mapa nas configurações do espaço.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Contacto exigido pelo serviço de mapas OpenStreetMap.
NOMINATIM_EMAIL=

# Portas no computador, se as predefinidas já estiverem ocupadas.
# DB_PORT=5433
# API_PORT=3000
# WEB_PORT=3001
